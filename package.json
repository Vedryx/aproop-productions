{
  "name": "aproop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "assets": "bash scripts/import-assets.sh",
    "setup:admin": "node scripts/setup-admin.mjs",
    "db:up": "docker compose up -d",
    "db:stop": "docker compose stop",
    "db:setup": "tsx scripts/setup-db.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:e2e": "playwright test",
    "test:visual": "playwright test visual.spec.ts",
    "test:visual:update": "playwright test visual.spec.ts --update-snapshots",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "ky": "2.1.0",
    "mongodb": "^7.6.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
