# Resend — https://resend.com/api-keys. Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries land. Defaults to the studio address if unset.
CONTACT_TO=aproop.production22@gmail.com

# Who they come from. Needs a domain verified in Resend; until then leave this
# unset and the route falls back to Resend's onboarding@resend.dev sender.
# CONTACT_FROM=Aproop Production <forms@aproopproductions.com>

# Studio admin: run npm run setup:admin to generate local credentials.
# Copy these settings into .env.local. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27019/?directConnection=true
MONGODB_DB=aproop
APP_ORIGIN=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Cashfree: server-only sandbox credentials, never NEXT_PUBLIC_.
# Use a separate local/sandbox DB. Keep production disabled during local testing.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_LIVE_ENABLED=false
# Required before enabling a story: zero (old demo figures) or existing (verified funds).
# Leave unset until the studio confirms the existing figures.
# CONTRIBUTION_OPENING_BALANCE_POLICY=zero
# Random secret for the reconciliation endpoint (external scheduler / Vercel Cron).
CRON_SECRET=
